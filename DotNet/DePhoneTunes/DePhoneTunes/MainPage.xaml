<phone:PhoneApplicationPage x:Class="DePhoneTunes.MainPage"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
                            xmlns:phoneControls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls"
                            xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
                            xmlns:local="clr-namespace:DePhoneTunes"
                            xmlns:phoneToolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
                            xmlns:interactivity="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                            xmlns:slabControls="clr-namespace:SLaB.Controls.Phone;assembly=SLaB.Controls.Phone"
                            xmlns:converters="clr-namespace:SLaB.Utilities.Xaml.Converters;assembly=SLaB.Utilities.Xaml.Phone"
                            xmlns:tilt="clr-namespace:Microsoft.Unsupported;assembly=SLaB.Controls.Phone"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            mc:Ignorable="d"
                            d:DesignWidth="480"
                            d:DesignHeight="800"
                            FontFamily="{StaticResource PhoneFontFamilyNormal}"
                            FontSize="{StaticResource PhoneFontSizeNormal}"
                            Foreground="{StaticResource PhoneForegroundBrush}"
                            SupportedOrientations="Portrait"
                            Orientation="Portrait"
                            shell:SystemTray.IsVisible="False">
    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <phoneControls:Panorama x:Name="mainPano"
                                Title="pitch perfect"
                                SelectionChanged="Panorama_SelectionChanged">
            <phoneControls:Panorama.Background>
                <ImageBrush ImageSource="/DePhoneTunes;component/PanoBackground.png"
                            Opacity=".25" />
            </phoneControls:Panorama.Background>
            <phoneControls:PanoramaItem>
                <phoneControls:PanoramaItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="G"
                                       FontFamily="MUSISYNC.TTF#MusiSync"
                                       Foreground="{StaticResource PhoneAccentBrush}"
                                       Margin="0"
                                       RenderTransformOrigin="0.5,0.5">
                        	<TextBlock.RenderTransform>
                        		<CompositeTransform ScaleX="1.7"
                                                    ScaleY="1.5" />
                        	</TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text=" notes" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1"
                                         tilt:TiltEffect.IsTiltEnabled="True"
                                         Margin="108,0,0,0"
                                         NavigateUri="/SettingsPage.xaml"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource HyperlinkButtonStyle}">
                            <Grid Width="65"
                                  Height="65">
                                <Grid.Background>
                                    <SolidColorBrush Opacity="0.001"
                                                     Color="Black" />
                                </Grid.Background>
                                <Ellipse Grid.Column="1"
                                         Width="48"
                                         Height="48"
                                         HorizontalAlignment="Center"
                                         Stroke="{StaticResource PhoneForegroundBrush}"
                                         StrokeThickness="2" />
                                <Rectangle Grid.Column="1"
                                           Fill="{StaticResource PhoneForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           Width="24"
                                           Height="33">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/DePhoneTunes;component/SettingsIcon.png" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                        </HyperlinkButton>
                    </Grid>
                </phoneControls:PanoramaItem.Header>
                <phoneControls:PanoramaItem.DataContext>
                    <local:PitchPipeModel IsCurrentModel="True" />
                </phoneControls:PanoramaItem.DataContext>
                <!--<slabControls:DelayCreateContentControl>
                    <DataTemplate>-->
                <local:PitchPipe />
                <!--</DataTemplate>
                </slabControls:DelayCreateContentControl>-->
            </phoneControls:PanoramaItem>
            <phoneControls:PanoramaItem>
                <phoneControls:PanoramaItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ú"
                                   FontFamily="MUSISYNC.TTF#MusiSync"
                                   Foreground="{StaticResource PhoneAccentBrush}"
                                   Margin="0"
                                   RenderTransformOrigin="0.5,0.5">
                        	<TextBlock.RenderTransform>
                        		<CompositeTransform ScaleX="1.7"
                                                    ScaleY="1.5"
                                                    TranslateY="10" />
                        	</TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="  pitches" />
                    </StackPanel>
                </phoneControls:PanoramaItem.Header>
                <phoneControls:PanoramaItem.DataContext>
                    <local:NotesModel />
                </phoneControls:PanoramaItem.DataContext>
                <!--<slabControls:DelayCreateContentControl>
                    <DataTemplate>-->
                <local:Notes />
                <!--</DataTemplate>
                </slabControls:DelayCreateContentControl>-->
            </phoneControls:PanoramaItem>
            <phoneControls:PanoramaItem x:Name="keyItem">
                <phoneControls:PanoramaItem.DataContext>
                    <local:KeysModel />
                </phoneControls:PanoramaItem.DataContext>
                <phoneControls:PanoramaItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="«"
                                   FontFamily="MUSIQWIK.TTF#MusiQwik"
                                   Foreground="{StaticResource PhoneAccentBrush}"
                                   Margin="0,0,0,-45"
                                   RenderTransformOrigin="0.5,0.5">
                        	<TextBlock.RenderTransform>
                        		<CompositeTransform ScaleX="1.5"
                                                    ScaleY="1.5"
                                                    TranslateY="-10" />
                        	</TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="  keys" />
                    </StackPanel>
                </phoneControls:PanoramaItem.Header>
                <!--<slabControls:DelayCreateContentControl>
                    <DataTemplate>-->
                <local:Keys />
                <!--</DataTemplate>
                </slabControls:DelayCreateContentControl>-->
            </phoneControls:PanoramaItem>
            <phoneControls:PanoramaItem x:Name="songsItem">
                <phoneControls:PanoramaItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&amp;¤"
                                   FontFamily="MusiQwikB.ttf#MusiQwikB"
                                   Foreground="{StaticResource PhoneAccentBrush}"
                                   Margin="0"
                                   RenderTransformOrigin="0.5,0.5"
                                   FontSize="56">
                        	<TextBlock.RenderTransform>
                        		<CompositeTransform ScaleX="1.7"
                                                    ScaleY="1.5"
                                                    TranslateY="10" />
                        	</TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="  songs" />
                    </StackPanel>
                </phoneControls:PanoramaItem.Header>
                <local:Songs />
            </phoneControls:PanoramaItem>
        </phoneControls:Panorama>
        <local:AdControl Grid.Row="1" />
    </Grid>
</phone:PhoneApplicationPage>