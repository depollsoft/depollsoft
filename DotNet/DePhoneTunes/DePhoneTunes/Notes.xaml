<UserControl x:Class="DePhoneTunes.Notes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:slabControls="clr-namespace:SLaB.Controls.Phone;assembly=SLaB.Controls.Phone"
             xmlns:converters="clr-namespace:SLaB.Utilities.Xaml.Converters;assembly=SLaB.Utilities.Xaml.Phone"
             xmlns:local="clr-namespace:DePhoneTunes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             FontFamily="{StaticResource PhoneFontFamilyNormal}"
             FontSize="{StaticResource PhoneFontSizeNormal}"
             Foreground="{StaticResource PhoneForegroundBrush}"
             d:DesignHeight="480"
             d:DesignWidth="480">

    <slabControls:TrialBlocker d:DataContext="{d:DesignInstance Type=local:NotesModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentPresenter Content="{Binding}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Slider Minimum="0"
                        Maximum="{Binding Notes.Count}"
                        SmallChange="1"
                        LargeChange="1"
                        Orientation="Vertical"
                        Value="{Binding SelectedNoteIndex, Mode=TwoWay}" />
                <ContentControl Grid.Column="1"
                                Margin="25"
                                HorizontalContentAlignment="Stretch"
                                Content="{Binding SelectedNote}"
                                ContentTemplate="{StaticResource NoteDT}" />
            </Grid>
            <!--<ListBox ItemsSource="{Binding Notes}"
                             SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="ListBox_SelectionChanged"
                             Loaded="ListBox_Loaded"
                             ItemTemplate="{StaticResource NoteDT}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>-->
            <local:MiniAboutControl x:Name="aboutControl"
                                    Grid.Row="2" />
        </Grid>
    </slabControls:TrialBlocker>
</UserControl>
