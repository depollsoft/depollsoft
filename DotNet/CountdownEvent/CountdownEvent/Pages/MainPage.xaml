<phone:PhoneApplicationPage x:Class="CountdownEvent.Pages.MainPage"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
                            xmlns:phoneControls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls"
                            xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
                            xmlns:slabControls="clr-namespace:SLaB.Controls.Phone;assembly=SLaB.Controls.Phone"
                            xmlns:internal="clr-namespace:CountdownEvent.Internal"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:perf="clr-namespace:Delay;assembly=SLaB.Controls.Phone"
                            xmlns:pages="clr-namespace:CountdownEvent.Pages"
                            xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
                            xmlns:xamlUtil="clr-namespace:SLaB.Utilities.Xaml;assembly=SLaB.Utilities.Xaml.Phone"
                            FontFamily="{StaticResource PhoneFontFamilyNormal}"
                            FontSize="{StaticResource PhoneFontSizeNormal}"
                            Foreground="{StaticResource PhoneForegroundBrush}"
                            SupportedOrientations="Portrait"
                            Orientation="Portrait"
                            mc:Ignorable="d"
                            d:DesignHeight="768"
                            d:DesignWidth="480"
                            shell:SystemTray.IsVisible="True">
    <phone:PhoneApplicationPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CountdownEvent;component/Pages/CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </phone:PhoneApplicationPage.Resources>

    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Background="Transparent">
        <phoneControls:Panorama x:Name="MainPano"
                                SelectionChanged="MainPanoSelectionChanged"
                                Title="{Binding ApplicationTitle, Source={StaticResource AppConfig}}"
                                Background="{Binding Source={StaticResource AppConfig}, Path=ApplicationBackgroundImage}"
                                xamlUtil:Tombstoner.TombstoneId="MainPano">
            <xamlUtil:Tombstoner.Tombstoner>
                <xamlUtil:Tombstoner>
                    <xamlUtil:TombstoneProperty PropertyName="DefaultIndex"
                                                RepeatUntilSuccess="True">
                        <xamlUtil:TombstoneProperty.AttachedPropertyTargetTypeStyle>
                            <Style TargetType="slabControls:PanoramaHelper" />
                        </xamlUtil:TombstoneProperty.AttachedPropertyTargetTypeStyle>
                    </xamlUtil:TombstoneProperty>
                </xamlUtil:Tombstoner>
            </xamlUtil:Tombstoner.Tombstoner>
            <phoneControls:PanoramaItem Header="{Binding EventName, Source={StaticResource AppConfig}, Converter={StaticResource ToLower}}">
                <ScrollViewer xamlUtil:Tombstoner.TombstoneId="MainScroller">
                    <xamlUtil:Tombstoner.Tombstoner>
                        <xamlUtil:Tombstoner>
                            <xamlUtil:TombstoneProperty PropertyName="VerticalOffset"
                                                        RepeatUntilRoundTrip="True"
                                                        RepeatUntilSuccess="True">
                                <xamlUtil:TombstoneProperty.AttachedPropertyTargetTypeStyle>
                                    <Style TargetType="slabControls:ScrollViewerHelper" />
                                </xamlUtil:TombstoneProperty.AttachedPropertyTargetTypeStyle>
                            </xamlUtil:TombstoneProperty>
                        </xamlUtil:Tombstoner>
                    </xamlUtil:Tombstoner.Tombstoner>
                    <StackPanel>
                        <TextBlock Text="{Binding PreparationText, Source={StaticResource AppConfig}}"
                                   Style="{StaticResource PhoneTextTitle2Style}"
                                   Foreground="{StaticResource PhoneAccentBrush}"
                                   Visibility="{Binding ElementName=Countdown, Path=IsComplete, Converter={StaticResource BoolConverter}, ConverterParameter=!}" />
                        <pages:CountdownTimer x:Name="Countdown"
                                              TextAlignment="Center"
                                              Margin="12"
                                              CountdownComplete="CountdownCompleted"
                                              CountdownReachedContent="{Binding EventMessage, Source={StaticResource AppConfig}}"
                                              TargetDate="{Binding EventDate, Source={StaticResource AppConfig}}">
                            <pages:CountdownTimer.TextStyle>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource PhoneTextTitle3Style}">
                                    <Setter Property="Margin"
                                            Value="0,0,0.1,0" />
                                </Style>
                            </pages:CountdownTimer.TextStyle>
                            <pages:CountdownTimer.CountdownReachedContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource PhoneAccentBrush}"
                                               Style="{StaticResource PhoneTextTitle2Style}" />
                                </DataTemplate>
                            </pages:CountdownTimer.CountdownReachedContentTemplate>
                        </pages:CountdownTimer>
                        <TextBlock Text="{Binding AboutHeader, Source={StaticResource AppConfig}}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource PhoneTextGroupHeaderStyle}" />
                        <TextBlock Margin="12"
                                   Text="{Binding Description, Source={StaticResource AppConfig}}"
                                   TextWrapping="Wrap" />
                        <HyperlinkButton HorizontalAlignment="Center"
                                         Content="More"
                                         NavigateUri="{Binding Wikipedia, Source={StaticResource AppConfig}}"
                                         TargetName="_blank" />
                        <TextBlock Text="About this app"
                                   TextWrapping="Wrap"
                                   Margin="0, 20, 0, 0"
                                   Style="{StaticResource PhoneTextGroupHeaderStyle}" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="12, 0">
                            <TextBlock Text="News, web, and image data provided by " />
                            <HyperlinkButton Content="Bing"
                                             NavigateUri="http://www.bing.com"
                                             Margin="-12, 0"
                                             FontSize="{StaticResource PhoneFontSizeSmall}"
                                             TargetName="_blank" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="12, 0">
                            <TextBlock Text="Video data provided by " />
                            <HyperlinkButton Content="YouTube"
                                             Margin="-12, 0"
                                             NavigateUri="http://www.youtube.com"
                                             FontSize="{StaticResource PhoneFontSizeSmall}"
                                             TargetName="_blank" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="12, 0">
                            <TextBlock Text="Description provided by " />
                            <HyperlinkButton Content="Wikipedia"
                                             Margin="-12, 0"
                                             NavigateUri="http://www.wikipedia.com"
                                             FontSize="{StaticResource PhoneFontSizeSmall}"
                                             TargetName="_blank" />
                        </StackPanel>
                        <pages:MiniAboutControl Margin="0,25,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </phoneControls:PanoramaItem>
            <phoneControls:PanoramaItem Header="news">
                <pages:FeedPresenter Feed="{Binding NewsFeedUri, Converter={StaticResource FeedConverter}, Source={StaticResource AppConfig}}"
                                     xamlUtil:Tombstoner.TombstoneId="NewsFeed">
                    <xamlUtil:Tombstoner.Tombstoner>
                        <xamlUtil:Tombstoner>
                            <xamlUtil:TombstoneProperty PropertyName="Feed" />
                        </xamlUtil:Tombstoner>
                    </xamlUtil:Tombstoner.Tombstoner>
                    <pages:FeedPresenter.ItemTemplate>
                        <DataTemplate>
                            <HyperlinkButton Style="{StaticResource HyperlinkButtonStyle}"
                                             NavigateUri="{Binding Link}"
                                             HorizontalContentAlignment="Stretch"
                                             TargetName="_blank">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               Margin="0"
                                               Style="{StaticResource PhoneTextTitle3Style}" />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="15,0">
                                        <TextBlock Text="Published: "
                                                   FontWeight="Bold"
                                                   FontStyle="Italic"
                                                   FontSize="{StaticResource PhoneFontSizeSmall}" />
                                        <TextBlock Text="{Binding Published}"
                                                   FontSize="{StaticResource PhoneFontSizeSmall}"
                                                   FontStyle="Italic" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Margin="15,0"
                                               Style="{StaticResource PhoneTextSubtleStyle}" />
                                </StackPanel>
                            </HyperlinkButton>
                        </DataTemplate>
                    </pages:FeedPresenter.ItemTemplate>
                </pages:FeedPresenter>
            </phoneControls:PanoramaItem>
            <phoneControls:PanoramaItem Header="videos">
                <pages:FeedPresenter Feed="{Binding VideoFeedUri, Converter={StaticResource FeedConverter}, ConverterParameter=Video, Source={StaticResource AppConfig}}"
                                     xamlUtil:Tombstoner.TombstoneId="VideoFeed">
                    <xamlUtil:Tombstoner.Tombstoner>
                        <xamlUtil:Tombstoner>
                            <xamlUtil:TombstoneProperty PropertyName="Feed" />
                        </xamlUtil:Tombstoner>
                    </xamlUtil:Tombstoner.Tombstoner>
                    <pages:FeedPresenter.ItemTemplate>
                        <DataTemplate>
                            <HyperlinkButton Style="{StaticResource HyperlinkButtonStyle}"
                                             NavigateUri="{Binding Link}"
                                             HorizontalContentAlignment="Stretch"
                                             TargetName="_blank">
                                <StackPanel Margin="5"
                                            HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource PhoneAccentBrush}" />
                                    <Image perf:LowProfileImageLoader.UriSource="{Binding Thumbnail}"
                                           Height="240" />
                                </StackPanel>
                            </HyperlinkButton>
                        </DataTemplate>
                    </pages:FeedPresenter.ItemTemplate>
                </pages:FeedPresenter>
            </phoneControls:PanoramaItem>
            <phoneControls:PanoramaItem Header="images">
                <pages:FeedPresenter Feed="{Binding ImageFeedUri, Converter={StaticResource FeedConverter}, ConverterParameter=Image, Source={StaticResource AppConfig}}"
                                     xamlUtil:Tombstoner.TombstoneId="ImageFeed">
                    <xamlUtil:Tombstoner.Tombstoner>
                        <xamlUtil:Tombstoner>
                            <xamlUtil:TombstoneProperty PropertyName="Feed" />
                        </xamlUtil:Tombstoner>
                    </xamlUtil:Tombstoner.Tombstoner>
                    <pages:FeedPresenter.ItemTemplate>
                        <DataTemplate>
                            <HyperlinkButton Style="{StaticResource HyperlinkButtonStyle}"
                                             NavigateUri="{Binding Content}"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch"
                                             Margin="-4,8"
                                             TargetName="_blank">
                                <toolkit:ContextMenuService.ContextMenu>
                                    <toolkit:ContextMenu>
                                        <toolkit:MenuItem Header="open image in browser"
                                                          Command="{StaticResource WebNavigateCommand}"
                                                          CommandParameter="{Binding Content}" />
                                        <toolkit:MenuItem Header="open source website"
                                                          Command="{StaticResource WebNavigateCommand}"
                                                          CommandParameter="{Binding Link}" />
                                    </toolkit:ContextMenu>
                                </toolkit:ContextMenuService.ContextMenu>
                                <Image perf:LowProfileImageLoader.UriSource="{Binding Thumbnail}"
                                       VerticalAlignment="Stretch"
                                       Height="200"
                                       Grid.Row="1" />
                            </HyperlinkButton>
                        </DataTemplate>
                    </pages:FeedPresenter.ItemTemplate>
                    <pages:FeedPresenter.ItemsPanel>
                        <ItemsPanelTemplate>
                            <slabControls:SequenceGrid ColumnCount="2" />
                        </ItemsPanelTemplate>
                    </pages:FeedPresenter.ItemsPanel>
                </pages:FeedPresenter>
            </phoneControls:PanoramaItem>
            <phoneControls:PanoramaItem Header="web">
                <pages:FeedPresenter Feed="{Binding WebSearchFeedUri, Converter={StaticResource FeedConverter}, Source={StaticResource AppConfig}}"
                                     xamlUtil:Tombstoner.TombstoneId="WebFeed">
                    <xamlUtil:Tombstoner.Tombstoner>
                        <xamlUtil:Tombstoner>
                            <xamlUtil:TombstoneProperty PropertyName="Feed" />
                        </xamlUtil:Tombstoner>
                    </xamlUtil:Tombstoner.Tombstoner>
                    <pages:FeedPresenter.ItemTemplate>
                        <DataTemplate>
                            <HyperlinkButton Style="{StaticResource HyperlinkButtonStyle}"
                                             NavigateUri="{Binding Link}"
                                             HorizontalContentAlignment="Stretch"
                                             TargetName="_blank">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               Margin="0"
                                               Style="{StaticResource PhoneTextTitle3Style}" />
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Margin="15,0"
                                               FontSize="{StaticResource PhoneFontSizeSmall}"
                                               Style="{StaticResource PhoneTextSubtleStyle}" />
                                </StackPanel>
                            </HyperlinkButton>
                        </DataTemplate>
                    </pages:FeedPresenter.ItemTemplate>
                </pages:FeedPresenter>
            </phoneControls:PanoramaItem>
        </phoneControls:Panorama>
    </Grid>

