<UserControl x:Class="BarbershopTags.AudioPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:SLaB.Utilities.Xaml.Converters;assembly=SLaB.Utilities.Xaml.Phone"
             xmlns:tilt="clr-namespace:Microsoft.Unsupported;assembly=SLaB.Controls.Phone"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400"
             xmlns:my="clr-namespace:BarbershopTags">
    <ContentControl x:Name="Enabler"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
        <Grid x:Name="LayoutRoot">
            <Grid.Resources>
                <my:TimeSpanConverter x:Key="TimeSpanConverter" />
                <my:TimeSpanStringConverter x:Key="TimeSpanStringConverter" />
                <converters:StringFormatConverter x:Key="StringFormatConverter" />
                <converters:BoolConverter x:Key="BoolConverter" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" />
                <ColumnDefinition Width="40*" />
                <ColumnDefinition Width="80*" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="playPauseButton"
                          tilt:TiltEffect.IsTiltEnabled="True"
                          Margin="4,-4,0,-4"
                          Click="ToggleButton_Click"
                          Grid.RowSpan="2">
                <ToggleButton.ContentTemplate>
                    <DataTemplate>
                        <Path Fill="{StaticResource PhoneForegroundBrush}"
                              Data="F0 M 0,0 L 0,14 L 10,7 L 0,0" />
                    </DataTemplate>
                </ToggleButton.ContentTemplate>
            </ToggleButton>
            <Button Grid.Column="1"
                    tilt:TiltEffect.IsTiltEnabled="True"
                    Margin="0,-4,4,-4"
                    Click="StopButton_Click"
                    Grid.RowSpan="2">
                <Rectangle Width="12"
                           Height="12"
                           Fill="{StaticResource PhoneForegroundBrush}" />
            </Button>
            <MediaElement Grid.Column="2"
                          AutoPlay="False"
                          Volume="1"
                          Balance="{Binding Path=Balance}"
                          x:Name="MediaElement"
                          Grid.RowSpan="2" />
            <Slider x:Name="positionSlider"
                    Margin="-12, 0, -12, -24"
                    Grid.Column="2"
                    Value="{Binding Path=Position, ElementName=MediaElement, Mode=TwoWay, Converter={StaticResource TimeSpanConverter}}"
                    LargeChange="1000" />
            <StackPanel Grid.Column="2"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="{Binding Path=Position, ElementName=MediaElement, Converter={StaticResource TimeSpanStringConverter}}" />
                <TextBlock Text=" / "
                           Visibility="{Binding Duration, Converter={StaticResource BoolConverter}}" />
                <TextBlock Text="{Binding Path=Duration, Converter={StaticResource TimeSpanStringConverter}}" />
            </StackPanel>
        </Grid>
    </ContentControl>
</UserControl>
