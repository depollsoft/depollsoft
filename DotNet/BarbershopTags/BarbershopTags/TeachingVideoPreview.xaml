<UserControl x:Class="BarbershopTags.TeachingVideoPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:performance="clr-namespace:Delay;assembly=PhonePerformance"
             xmlns:slabControls="clr-namespace:SLaB.Controls.Phone;assembly=SLaB.Controls.Phone"
             xmlns:converters="clr-namespace:SLaB.Utilities.Xaml.Converters;assembly=SLaB.Utilities.Xaml.Phone"
             xmlns:local="clr-namespace:BarbershopTags"
             xmlns:tilt="clr-namespace:Microsoft.Unsupported;assembly=SLaB.Controls.Phone"
             mc:Ignorable="d"
             FontFamily="{StaticResource PhoneFontFamilyNormal}"
             FontSize="{StaticResource PhoneFontSizeNormal}"
             Foreground="{StaticResource PhoneForegroundBrush}"
             d:DesignHeight="480"
             d:DesignWidth="480">

    <Grid x:Name="LayoutRoot">
        <HyperlinkButton Style="{StaticResource HyperlinkButtonStyle}"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch"
                         NavigateUri="{Binding WatchUri}"
                         Margin="-12,0"
                         TargetName="_top">
            <Grid Margin="4">
                <!--<Grid.Background>
                    <SolidColorBrush Color="Gray"
                                     Opacity="0.1" />
                </Grid.Background>-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2.5*" />
                </Grid.ColumnDefinitions>
                <Image performance:LowProfileImageLoader.UriSource="{Binding ThumbnailUri}"
                       Margin="8,4" />
                <slabControls:DetailsLayout VerticalAlignment="Center"
                                            Grid.Column="1">
                    <slabControls:Detail>
                        <slabControls:Detail.Header>
                            <TextBlock Text="Teacher"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Visibility="{Binding TargetTag.Teacher, Converter={StaticResource BoolConverter}}"
                                       FontSize="{StaticResource PhoneFontSizeSmall}" />
                        </slabControls:Detail.Header>
                        <slabControls:Detail.Content>
                            <Grid Margin="5"
                                  Visibility="{Binding TargetTag.Teacher, Converter={StaticResource BoolConverter}}">
                                <TextBlock Text="{Binding TargetTag.Teacher}"
                                           FontSize="{StaticResource PhoneFontSizeSmall}" />
                            </Grid>
                        </slabControls:Detail.Content>
                    </slabControls:Detail>
                </slabControls:DetailsLayout>
            </Grid>
        </HyperlinkButton>
    </Grid>
</UserControl>
