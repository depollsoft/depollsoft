<phone:PhoneApplicationPage x:Class="BarbershopTags.SearchPage"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
                            xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:slabControls="clr-namespace:SLaB.Controls.Phone;assembly=SLaB.Controls.Phone"
                            xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib"
                            xmlns:local="clr-namespace:BarbershopTags"
                            xmlns:bbshop="clr-namespace:BarbershopTags.Barbershop"
                            FontFamily="{StaticResource PhoneFontFamilyNormal}"
                            FontSize="{StaticResource PhoneFontSizeNormal}"
                            Foreground="{StaticResource PhoneForegroundBrush}"
                            SupportedOrientations="PortraitOrLandscape"
                            Orientation="Portrait"
                            mc:Ignorable="d"
                            d:DesignHeight="696"
                            d:DesignWidth="480"
                            shell:SystemTray.IsVisible="True">
    <!--<toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn" />
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn" />
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut" />
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut" />
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>-->
    <!--LayoutRoot is the root grid where all page content is placed-->
    <Grid x:Name="LayoutRoot"
          Background="{StaticResource ImageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--TitlePanel contains the name of the application and page title-->
        <StackPanel x:Name="TitlePanel"
                    Grid.Row="0"
                    Margin="12,17,0,28">
            <TextBlock x:Name="ApplicationTitle"
                       Text="Tag Master"
                       Style="{StaticResource PhoneTextNormalStyle}"
                       FontFamily="Assets/wickhop-handwriting.ttf#wickhop handwriting" />
            <TextBlock x:Name="PageTitle"
                       Text="search"
                       Margin="9,-7,0,0"
                       Style="{StaticResource PhoneTextTitle1Style}" />
        </StackPanel>

        <!--ContentPanel - place additional content here-->
        <ScrollViewer Grid.Row="1">
            <Grid x:Name="ContentPanel"
                  Height="Auto"
                  Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="QueryBox"
                         InputScope="Text"
                         KeyUp="OnKeyTyped"
                         Grid.ColumnSpan="2" />
                <TextBlock Grid.Row="2"
                           Text="Sheet music"
                           FontWeight="Bold"
                           VerticalAlignment="Top"
                           Margin="0,20,0,0" />
                <toolkit:ListPicker Grid.Row="2"
                                    Grid.Column="1"
                                    x:Name="SheetMusic"
                                    Margin="5">
                    <local:KeyValue Key="Not important"
                                    Value="{x:Null}" />
                    <local:KeyValue Key="Yes">
                        <sys:Boolean>True</sys:Boolean>
                    </local:KeyValue>
                    <local:KeyValue Key="No">
                        <sys:Boolean>False</sys:Boolean>
                    </local:KeyValue>
                </toolkit:ListPicker>
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Learning tracks"
                           FontWeight="Bold"
                           VerticalAlignment="Top"
                           Margin="0,20,0,0" />
                <toolkit:ListPicker Grid.Row="3"
                                    Grid.Column="1"
                                    x:Name="LearningTracks"
                                    Margin="5">
                    <local:KeyValue Key="Not important"
                                    Value="{x:Null}" />
                    <local:KeyValue Key="Yes">
                        <sys:Boolean>True</sys:Boolean>
                    </local:KeyValue>
                    <local:KeyValue Key="No">
                        <sys:Boolean>False</sys:Boolean>
                    </local:KeyValue>
                </toolkit:ListPicker>
                <TextBlock Grid.Row="4"
                           Text="Parts"
                           FontWeight="Bold"
                           VerticalAlignment="Top"
                           Margin="0,20,0,0" />
                <toolkit:ListPicker Grid.Row="4"
                                    Grid.Column="1"
                                    x:Name="Parts"
                                    Margin="5">
                    <local:KeyValue Key="Any"
                                    Value="{x:Null}" />
                    <local:KeyValue Key="3">
                        <sys:Int32>3</sys:Int32>
                    </local:KeyValue>
                    <local:KeyValue Key="4">
                        <sys:Int32>4</sys:Int32>
                    </local:KeyValue>
                    <local:KeyValue Key="5">
                        <sys:Int32>5</sys:Int32>
                    </local:KeyValue>
                    <local:KeyValue Key="6">
                        <sys:Int32>6</sys:Int32>
                    </local:KeyValue>
                    <local:KeyValue Key="7">
                        <sys:Int32>7</sys:Int32>
                    </local:KeyValue>
                    <local:KeyValue Key="8">
                        <sys:Int32>8</sys:Int32>
                    </local:KeyValue>
                </toolkit:ListPicker>
                <TextBlock Grid.Row="5"
                           Text="Tag collection"
                           FontWeight="Bold"
                           VerticalAlignment="Top"
                           Margin="0,20,0,0" />
                <toolkit:ListPicker Grid.Row="5"
                                    Grid.Column="1"
                                    x:Name="TagCollection"
                                    Margin="5">
                    <local:KeyValue Key="Any"
                                    Value="{x:Null}" />
                    <local:KeyValue Key="Classic Tags">
                        <bbshop:TagCollection>ClassicTags</bbshop:TagCollection>
                    </local:KeyValue>
                    <local:KeyValue Key="Easy Tags">
                        <bbshop:TagCollection>EasyTags</bbshop:TagCollection>
                    </local:KeyValue>
                </toolkit:ListPicker>
                <TextBlock Grid.Row="1"
                           Text="Sort by"
                           FontWeight="Bold"
                           VerticalAlignment="Top"
                           Margin="0,20,0,0" />
                <toolkit:ListPicker Grid.Row="1"
                                    Grid.Column="1"
                                    x:Name="SortBy"
                                    Margin="5">
                    <local:KeyValue Key="Title">
                        <bbshop:TagSortOptions>Title</bbshop:TagSortOptions>
                    </local:KeyValue>
                    <local:KeyValue Key="Downloads">
                        <bbshop:TagSortOptions>Downloaded</bbshop:TagSortOptions>
                    </local:KeyValue>
                    <local:KeyValue Key="Most recent">
                        <bbshop:TagSortOptions>Posted</bbshop:TagSortOptions>
                    </local:KeyValue>
                    <local:KeyValue Key="Rating">
                        <bbshop:TagSortOptions>Rating</bbshop:TagSortOptions>
                    </local:KeyValue>
                </toolkit:ListPicker>
            </Grid>
        </ScrollViewer>
    </Grid>
    <!--Sample code showing usage of ApplicationBar-->
    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True"
                              IsMenuEnabled="False">
            <shell:ApplicationBarIconButton IconUri="/Icons/appbar.feature.search.rest.png"
                                            Text="search"
                                            Click="SearchButtonClick" />
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

</phone:PhoneApplicationPage>
