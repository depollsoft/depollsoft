<UserControl x:Class="CountdownEvent.Pages.MiniAboutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:slabControls="clr-namespace:SLaB.Controls.Phone;assembly=SLaB.Controls.Phone"
             mc:Ignorable="d"
             FontFamily="{StaticResource PhoneFontFamilyNormal}"
             FontSize="{StaticResource PhoneFontSizeNormal}"
             Foreground="{StaticResource PhoneForegroundBrush}"
             d:DesignHeight="800"
             d:DesignWidth="480">
    <StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock FontSize="{StaticResource PhoneFontSizeSmall}"
                       Text="{Binding ApplicationTitle, Source={StaticResource AppConfig}}" />
            <TextBlock FontSize="{StaticResource PhoneFontSizeSmall}"
                       Text=" Countdown" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <TextBlock FontSize="{StaticResource PhoneFontSizeSmall}"
                       Text="Version " />
            <TextBlock FontSize="{StaticResource PhoneFontSizeSmall}"
                       Text="{Binding AppVersion, Source={StaticResource AppConfig}}" />
            <TextBlock FontSize="{StaticResource PhoneFontSizeSmall}"
                       Text=" - " />
            <slabControls:MarketplaceNavigator>
                <HyperlinkButton Content="Rate &amp; Review"
                                 Margin="-12,0"
                                 FontSize="{StaticResource PhoneFontSizeSmall}"
                                 NavigateUri="marketplace:///" />
            </slabControls:MarketplaceNavigator>
        </StackPanel>
        <TextBlock HorizontalAlignment="Center"
                   FontSize="{StaticResource PhoneFontSizeSmall}"
                   Text="DepollSoft © 2011" />
        <HyperlinkButton Content="DavidPoll.com"
                         NavigateUri="http://www.davidpoll.com"
                         TargetName="_blank"
                         FontSize="{StaticResource PhoneFontSizeSmall}" />
    </StackPanel>
</UserControl>
