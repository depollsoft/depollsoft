<UserControl x:Class="DePhoneTunes.PitchPipe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DePhoneTunes"
             xmlns:slabControls="clr-namespace:SLaB.Controls.Phone;assembly=SLaB.Controls.Phone"
             xmlns:converters="clr-namespace:SLaB.Utilities.Xaml.Converters;assembly=SLaB.Utilities.Xaml.Phone"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             FontFamily="{StaticResource PhoneFontFamilyNormal}"
             FontSize="{StaticResource PhoneFontSizeNormal}"
             Foreground="{StaticResource PhoneForegroundBrush}"
             d:DesignHeight="480"
             d:DesignWidth="480">

    <Grid d:DataContext="{d:DesignInstance Type=local:PitchPipeModel}">
        <Grid.Resources>
            <DataTemplate x:Key="ToggleTemplate">
                <ToggleButton IsChecked="{Binding IsPlaying, Mode=TwoWay}"
                              Content="{Binding}"
                              ContentTemplate="{StaticResource PitchPipeNoteDT}" />
            </DataTemplate>
            <DataTemplate x:Key="ContinuousTemplate">
                <slabControls:ContinuousButton IsDepressed="{Binding IsPlaying, Mode=TwoWay}"
                                               Content="{Binding}"
                                               ContentTemplate="{StaticResource PitchPipeNoteDT}" />
            </DataTemplate>
            <converters:SwitchConverter x:Key="TemplateSwitcher">
                <converters:KeyValue Value="{StaticResource ToggleTemplate}">
                    <converters:KeyValue.Key>
                        <sys:Boolean>True</sys:Boolean>
                    </converters:KeyValue.Key>
                </converters:KeyValue>
                <converters:KeyValue Value="{StaticResource ContinuousTemplate}">
                    <converters:KeyValue.Key>
                        <sys:Boolean>False</sys:Boolean>
                    </converters:KeyValue.Key>
                </converters:KeyValue>
            </converters:SwitchConverter>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Row="0"
                              Grid.Column="1"
                              Content="{Binding Notes[0]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="0"
                              Grid.Column="2"
                              Content="{Binding Notes[1]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="0"
                              Grid.Column="3"
                              Content="{Binding Notes[2]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="1"
                              Grid.Column="3"
                              Content="{Binding Notes[3]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="2"
                              Grid.Column="3"
                              Content="{Binding Notes[4]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="3"
                              Grid.Column="3"
                              Content="{Binding Notes[5]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="3"
                              Grid.Column="2"
                              Content="{Binding Notes[6]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="3"
                              Grid.Column="1"
                              Content="{Binding Notes[7]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="3"
                              Grid.Column="0"
                              Content="{Binding Notes[8]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="2"
                              Grid.Column="0"
                              Content="{Binding Notes[9]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="1"
                              Grid.Column="0"
                              Content="{Binding Notes[10]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <ContentPresenter Grid.Row="0"
                              Grid.Column="0"
                              Content="{Binding Notes[11]}"
                              ContentTemplate="{Binding Source={StaticResource SettingsModel}, Path=UseToggleNotes, Converter={StaticResource TemplateSwitcher}}" />
            <RadioButton GroupName="PitchRange"
                         Content="From C to C"
                         IsChecked="{Binding IsFromFToF, Mode=TwoWay, Converter={StaticResource InverterConverter}}"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2" />
            <slabControls:TrialBlocker Grid.Row="2"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2">
                <RadioButton GroupName="PitchRange"
                             Content="From F to F"
                             IsChecked="{Binding IsFromFToF, Mode=TwoWay}" />
            </slabControls:TrialBlocker>
        </Grid>
        <local:MiniAboutControl x:Name="aboutControl"
                                Grid.Row="1" />
    </Grid>
</UserControl>
