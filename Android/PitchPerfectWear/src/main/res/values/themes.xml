<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PitchPerfect.Wear" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/plate_ground</item>
    </style>

    <!-- Wear app quality guideline WO-V15: the launcher icon, 48x48dp, centred on a black
         splash screen. The drawable sizes the icon and the background is pure black, not
         plate_ground: Play rejected the 60dp disc on plate_ground that the bare launcher icon
         produced as "Missing app icon in splash screen". -->
    <style name="Theme.PitchPerfect.Wear.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/Theme.PitchPerfect.Wear</item>
    </style>
</resources>
