<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The note-bound fill owns touch feedback; keep native focus/hover feedback. -->
    <item android:state_activated="true" android:color="@android:color/transparent" />
    <item android:state_pressed="true" android:color="@android:color/transparent" />
    <item android:color="?attr/colorControlHighlight" />
</selector>
