<?xml version="1.0" encoding="utf-8"?>
<!-- 1dp hairline down the starting edge, separating the list pane from the tag beside it. It sits
     below the two panes' shared charcoal bar, so the bar reads as one band across the window. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="1dp"
        android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>
