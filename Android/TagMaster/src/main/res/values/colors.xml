<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tag Master's established character: charcoal surfaces, one blue for the
      thing you can act on, and the barber pole as a quiet mark rather than a
      watermark. These raw values feed the Material 3 roles in themes.xml; screens
      reference the roles (?attr/colorPrimary, ?attr/colorSurface, ...), never
      these names, so light and dark resolve from one definition.
    -->
    <color name="dark">#474747</color>
    <color name="darker">#373737</color>
    <color name="barberpole">#11333333</color>
    <color name="accent">@android:color/holo_blue_dark</color>

    <!-- Light scheme -->
    <color name="tm_primary">#00637D</color>
    <color name="tm_on_primary">#FFFFFF</color>
    <color name="tm_primary_container">#B6EAFF</color>
    <color name="tm_on_primary_container">#001F28</color>
    <color name="tm_secondary">#474747</color>
    <color name="tm_on_secondary">#FFFFFF</color>
    <color name="tm_secondary_container">#DCE4E8</color>
    <color name="tm_on_secondary_container">#1B1C1D</color>
    <color name="tm_background">#FBFCFE</color>
    <color name="tm_on_background">#191C1D</color>
    <color name="tm_surface">#FBFCFE</color>
    <color name="tm_on_surface">#191C1D</color>
    <color name="tm_surface_variant">#DBE4E7</color>
    <color name="tm_on_surface_variant">#3F484B</color>
    <color name="tm_surface_container">#EFF1F3</color>
    <color name="tm_outline">#6F797C</color>
    <color name="tm_outline_variant">#BFC8CB</color>
    <color name="tm_error">#BA1A1A</color>
    <color name="tm_on_error">#FFFFFF</color>
    <color name="tm_error_container">#FFDAD6</color>
    <color name="tm_on_error_container">#410002</color>
</resources>
