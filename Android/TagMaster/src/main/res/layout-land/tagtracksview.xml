<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape Tracks: recording notes and the player on the left, the part picker on the right.
     Same ids as layout/tagtracksview.xml. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/trackNotesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/RecordingNotes"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <TextView
                    android:id="@+id/trackNotesTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
            </LinearLayout>

            <depollsoft.tagmaster.MediaPlayerView
                android:id="@+id/mediaPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/sorryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/SorryNoTracks"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/partsRadioGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/allPartsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/AllParts"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/tenorButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Tenor"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/leadButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Lead"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/bariButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Baritone"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/bassButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Bass"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/other1Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Other1"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/other2Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Other2"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/other3Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Other3"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/other4Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/Other4"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

        </RadioGroup>
    </LinearLayout>
</ScrollView>
