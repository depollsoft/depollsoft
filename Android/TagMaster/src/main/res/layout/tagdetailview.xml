<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen tag detail (phones, deep links, Random Tag). The detail itself lives in
     TagDetailFragment so tablets can host the same pages beside a list (@layout/tag_detail_pane).
     The <fragment> tag creates the pages' views during setContentView, so the activity's views and
     its first load are in place by the end of onCreate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/app_toolbar" />

    <fragment
        android:id="@+id/tagDetailFragment"
        android:name="depollsoft.tagmaster.TagDetailFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
