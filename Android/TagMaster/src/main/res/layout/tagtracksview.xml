<?xml version="1.0" encoding="utf-8"?>
<!--
  Tracks: pick a part, then work it. The player stays pinned at the bottom while
  the part list scrolls, because in practice a singer scrubs and re-balances far
  more often than they change part.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <depollsoft.tagmaster.ReadableWidthLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/tm_space_l"
            android:paddingTop="@dimen/tm_space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/tm_gutter"
                android:paddingEnd="@dimen/tm_gutter">

                <TextView
                    android:id="@+id/sorryTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/SorryNoTracks"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/partsHeading"
                    style="@style/TextAppearance.TagMaster.SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ChooseATrack" />

                <RadioGroup
                    android:id="@+id/partsRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_s">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/allPartsButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/AllParts" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/tenorButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Tenor" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/leadButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Lead" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/bariButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Baritone" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/bassButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Bass" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/other1Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Other1" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/other2Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Other2" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/other3Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Other3" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/other4Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/tm_touch_target"
                        android:text="@string/Other4" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/trackNotesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_xl"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView1"
                        style="@style/TextAppearance.TagMaster.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/RecordingNotes" />

                    <TextView
                        android:id="@+id/trackNotesTextView"
                        style="@style/TextAppearance.TagMaster.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tm_space_xs" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </depollsoft.tagmaster.ReadableWidthLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <depollsoft.tagmaster.MediaPlayerView
        android:id="@+id/mediaPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:paddingStart="@dimen/tm_gutter"
        android:paddingEnd="@dimen/tm_gutter"
        android:paddingTop="@dimen/tm_space_s"
        android:paddingBottom="@dimen/tm_space_s" />

</LinearLayout>
