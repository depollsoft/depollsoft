<?xml version="1.0" encoding="utf-8"?>
<!-- Title first; ID and read-only material availability support scanning. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/tm_touch_target"
    android:orientation="vertical"
    android:paddingStart="@dimen/tm_gutter"
    android:paddingEnd="@dimen/tm_gutter"
    android:paddingTop="@dimen/tm_space_s"
    android:paddingBottom="@dimen/tm_space_s">

    <TextView
        android:id="@+id/titleTextView"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/akaTextView"
        style="@style/TextAppearance.TagMaster.FieldValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tm_space_xs"
        android:visibility="gone"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/materialStatusTextView"
        style="@style/TextAppearance.TagMaster.FieldValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tm_space_xs"
        android:clickable="false"
        android:focusable="false"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
