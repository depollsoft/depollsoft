<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp" >

    <depollsoft.lib.ui.LoadingImageView
        android:id="@+id/videoPreview"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_weight="0" />

    <TableLayout
        android:id="@+id/tableLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|fill_horizontal"
        android:layout_weight="1"
        android:shrinkColumns="1"
        android:stretchColumns="1" >

        <TableRow
            android:id="@+id/tableRow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:clickable="false"
                android:linksClickable="false"
                android:longClickable="false"
                android:text="@string/SungBy"
                android:textAppearance="?attr/textAppearanceLabelLarge" >
            </TextView>

            <TextView
                android:id="@+id/sungByTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:linksClickable="false"
                android:longClickable="false"
                android:textAppearance="?attr/textAppearanceBodyMedium" >
            </TextView>
        </TableRow>

        <TableRow
            android:id="@+id/keyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:clickable="false"
                android:linksClickable="false"
                android:longClickable="false"
                android:text="@string/Key"
                android:textAppearance="?attr/textAppearanceLabelLarge" >
            </TextView>

            <TextView
                android:id="@+id/keyTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:linksClickable="false"
                android:longClickable="false"
                android:textAppearance="?attr/textAppearanceBodyMedium" >
            </TextView>
        </TableRow>

        <TableRow
            android:id="@+id/postedRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:clickable="false"
                android:linksClickable="false"
                android:longClickable="false"
                android:text="@string/Posted"
                android:textAppearance="?attr/textAppearanceLabelLarge" >
            </TextView>

            <TextView
                android:id="@+id/postedTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:linksClickable="false"
                android:longClickable="false"
                android:textAppearance="?attr/textAppearanceBodyMedium" >
            </TextView>
        </TableRow>

        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical" >

            <depollsoft.tagmaster.StatusIndicatorView
                android:id="@+id/multitrackCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:clickable="false"
                android:text="@string/Multitrack"
                android:textAppearance="?attr/textAppearanceBodyMedium" >
            </depollsoft.tagmaster.StatusIndicatorView>
        </LinearLayout>
    </TableLayout>

</LinearLayout>