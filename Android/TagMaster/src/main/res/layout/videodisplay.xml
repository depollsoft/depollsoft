<?xml version="1.0" encoding="utf-8"?>
<!-- One posted performance: who sang it, in what key, when, and whether it is
     a multitrack. The whole row opens the video. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/tm_touch_target"
    android:paddingStart="@dimen/tm_gutter"
    android:paddingEnd="@dimen/tm_gutter"
    android:paddingTop="@dimen/tm_space_s"
    android:paddingBottom="@dimen/tm_space_s">

    <depollsoft.lib.ui.LoadingImageView
        android:id="@+id/videoPreview"
        android:layout_width="88dp"
        android:layout_height="66dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/VideoThumbnail" />

    <LinearLayout
        android:id="@+id/tableLayout1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tm_space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sungByTextView"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/keyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textView3"
                style="@style/TextAppearance.TagMaster.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/tm_space_xs"
                android:text="@string/Key" />

            <TextView
                android:id="@+id/keyTextView"
                style="@style/TextAppearance.TagMaster.FieldValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/postedTextView"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/multitrackCheckBox"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/ic_yesnocheck"
            android:buttonTint="@android:color/transparent"
            android:buttonTintMode="add"
            android:clickable="false"
            android:focusable="false"
            android:text="@string/Multitrack"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</LinearLayout>
