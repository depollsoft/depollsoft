<?xml version="1.0" encoding="utf-8"?>
<!-- The tag's teaching video, with the teacher named. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/tm_touch_target">

    <depollsoft.lib.ui.LoadingImageView
        android:id="@+id/videoPreview"
        android:layout_width="88dp"
        android:layout_height="66dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/VideoThumbnail" />

    <LinearLayout
        android:id="@+id/tableLayout1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tm_space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView1"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Teacher" />

        <TextView
            android:id="@+id/teacherTextView"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

</LinearLayout>
