<?xml version="1.0" encoding="utf-8"?>
<!-- The tag beside the list on wide windows. Its charcoal bar matches @layout/app_toolbar and runs
     uninterrupted into the list's, so the two read as one band; the hairline separating the panes
     is drawn down the content's starting edge below them. Underneath sits either the "Pick a tag"
     invitation or the TagDetailFragment that TagPaneController swaps tags into. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailPane"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/detailAppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_chrome"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.TagMaster.Chrome"
        app:elevation="0dp"
        app:liftOnScroll="true"
        app:liftOnScrollColor="@color/brand_chrome">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/detailToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/brand_chrome"
            app:popupTheme="@style/ThemeOverlay.TagMaster.Popup"
            app:titleTextColor="@color/brand_on_chrome" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/detailContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/pane_hairline">

        <include layout="@layout/tag_pane_empty" />
    </FrameLayout>
</LinearLayout>
