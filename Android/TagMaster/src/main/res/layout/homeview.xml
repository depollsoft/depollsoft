<?xml version="1.0" encoding="utf-8"?>
<!--
  Home is the desk itself: the three ways in, then the repertoire the singer
  brought with them. Both lists work without an account.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/tm_space_xl">

    <depollsoft.tagmaster.ReadableWidthLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <depollsoft.tagmaster.MeHeaderView
                android:id="@+id/meHeaderView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/yourListsHeading"
                style="@style/TextAppearance.TagMaster.SectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_l"
                android:layout_marginBottom="@dimen/tm_space_s"
                android:paddingStart="@dimen/tm_gutter"
                android:paddingEnd="@dimen/tm_gutter"
                android:text="@string/YourLists" />

            <LinearLayout
                android:id="@+id/yourListsEntries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/favoritesButton"
                    style="@style/Widget.TagMaster.ListEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Favorites" />

                <TextView
                    android:id="@+id/teachableButton"
                    style="@style/Widget.TagMaster.ListEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/TeachableTags" />
            </LinearLayout>

            <include layout="@layout/meviewfooter" />
        </LinearLayout>
    </depollsoft.tagmaster.ReadableWidthLayout>

</androidx.core.widget.NestedScrollView>
