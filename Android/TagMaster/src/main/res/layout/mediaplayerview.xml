<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playPauseButton"
            style="?attr/materialIconButtonFilledStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            app:iconGravity="textStart"
            android:contentDescription="@string/Play"
            app:icon="@drawable/ic_play"
            app:iconPadding="0dp"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            style="?attr/materialIconButtonOutlinedStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            app:iconGravity="textStart"
            android:enabled="false"
            android:contentDescription="@string/Stop"
            app:icon="@drawable/ic_stop"
            app:iconPadding="0dp"
            app:iconSize="24dp" />

        <depollsoft.tagmaster.BarberPoleLoadingView
            android:id="@+id/trackLoadingIndicator"
            style="@style/Widget.TagMaster.CompactLoader"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/detail_track_loading" />

        <TextView
            android:id="@+id/counterTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:minWidth="96dp"
            android:textAppearance="?attr/textAppearanceLabelMedium" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/counterSeekBar"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:valueFrom="0"
        android:valueTo="1"
        android:value="0"
        android:contentDescription="@string/detail_playback_position"
        app:labelBehavior="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/Balance"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/balanceSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:valueFrom="0"
            android:valueTo="1000"
            android:value="500"
            android:contentDescription="@string/Balance"
            app:labelBehavior="gone" />
    </LinearLayout>
</LinearLayout>
