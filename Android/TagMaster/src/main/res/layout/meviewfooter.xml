<?xml version="1.0" encoding="utf-8"?>
<!--
  Attribution and the app's own identity, kept where it belongs: at the end of
  the desk, quiet, but never dropped. BarbershopTags.com provides the catalogue
  and the link stays on every install.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tm_space_xxl"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/tm_gutter"
    android:paddingEnd="@dimen/tm_gutter">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/tm_space_l"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/linkLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textView7"
            style="@style/TextAppearance.TagMaster.FieldValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ContentProvider"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <depollsoft.lib.ui.Hyperlink
            android:id="@+id/textView4"
            style="@style/TextAppearance.TagMaster.FieldValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tm_space_xs"
            android:gravity="center_vertical"
            android:minHeight="@dimen/tm_touch_target"
            android:tag="http://www.barbershoptags.com"
            android:text="@string/BarbershopTagsCom"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appDisplayLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/appNameTextView"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/dashTextView"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - " />

        <TextView
            android:id="@+id/appVersionTextView"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <depollsoft.lib.ui.Hyperlink
            android:id="@+id/TextView01"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/tm_touch_target"
            android:tag="http://apps.depoll.com"
            android:text="@string/DepollSoft"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/copyrightTextView"
            style="@style/TextAppearance.TagMaster.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tm_space_xs"
            android:text="@string/Copyright" />
    </LinearLayout>

    <depollsoft.lib.ui.Hyperlink
        android:id="@+id/marketHyperlink"
        style="@style/TextAppearance.TagMaster.FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/tm_touch_target"
        android:tag="https://market.android.com/details?id=depollsoft.pitchperfect"
        android:text="@string/FreePitchPipe"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <depollsoft.lib.ui.Hyperlink
        android:id="@+id/termsHyperlink"
        style="@style/TextAppearance.TagMaster.FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/tm_touch_target"
        android:tag="http://apps.depoll.com/terms-of-use"
        android:text="@string/TermsOfUse"
        android:textColor="?attr/colorPrimary" />

    <depollsoft.lib.ui.Hyperlink
        android:id="@+id/donateHyperlink"
        style="@style/TextAppearance.TagMaster.FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/tm_touch_target"
        android:tag="http://www.davidpoll.com/applications/tag-master/donate"
        android:text="@string/Donate"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
