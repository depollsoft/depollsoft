<?xml version="1.0" encoding="utf-8"?>
<!--
  The three ways into a tag, in the order a singer reaches for them: look one up,
  let the app pick, or type the ID someone just read out across the room.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/tm_gutter"
    android:paddingEnd="@dimen/tm_gutter"
    android:paddingTop="@dimen/tm_space_l">

    <!-- Fetching a random tag is a wait, not an interruption: the desk stays on
         screen and reports progress here rather than behind a modal. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/homeProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tm_space_s"
        android:indeterminate="true"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/findTagButton"
        style="@style/Widget.TagMaster.HomeAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/FindATag"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:iconTint="?attr/colorOnPrimary"
        app:icon="@drawable/ic_search" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/randomTagButton"
        style="@style/Widget.TagMaster.HomeAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/RandomTag"
        app:icon="@drawable/ic_rotate" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openByIdButton"
        style="@style/Widget.TagMaster.HomeAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/OpenTagId"
        app:icon="@drawable/ic_launch" />

</LinearLayout>
