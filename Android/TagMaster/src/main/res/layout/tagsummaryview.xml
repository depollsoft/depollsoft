<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <ScrollView android:id="@+id/scrollView1" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="16dp" android:paddingBottom="16dp">
    <LinearLayout android:id="@+id/tableLayout1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:orientation="vertical">
      <LinearLayout android:id="@+id/linearLayout1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/titleTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:longClickable="false" android:textAppearance="?attr/textAppearanceHeadlineSmall">
                </TextView>
        <LinearLayout android:id="@+id/akaLayout" android:layout_width="match_parent" android:layout_height="wrap_content">
          <TextView android:id="@+id/textView7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:longClickable="false" android:text="@string/aka" android:textAppearance="?attr/textAppearanceBodyMedium">
                    </TextView>
          <TextView android:id="@+id/akaTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:clickable="false" android:longClickable="false" android:singleLine="false" android:textAppearance="?attr/textAppearanceBodyMedium">
                    </TextView>
        </LinearLayout>
        <LinearLayout android:id="@+id/versionLayout" android:layout_width="match_parent" android:layout_height="wrap_content">
          <TextView android:id="@+id/textView8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:longClickable="false" android:text="@string/Version" android:textAppearance="?attr/textAppearanceBodyMedium">
                    </TextView>
          <TextView android:id="@+id/versionTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:clickable="false" android:longClickable="false" android:textAppearance="?attr/textAppearanceBodyMedium">
                    </TextView>
        </LinearLayout>
        <LinearLayout android:id="@+id/savedStatusLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
          <TextView android:id="@+id/favoriteMarkerTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="@string/FavoriteIndicator" android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="?attr/textAppearanceLabelLarge"/>
          <TextView android:id="@+id/teachableMarkerTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/TeachableIndicator" android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="?attr/textAppearanceLabelLarge"/>
        </LinearLayout>
      </LinearLayout>
      <depollsoft.tagmaster.SummaryColumnsLayout android:id="@+id/summaryColumns" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <depollsoft.tagmaster.DetailSectionsLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <depollsoft.tagmaster.DetailMetadataLayout android:id="@+id/summaryFacts" android:layout_width="match_parent" android:layout_height="wrap_content">
            <depollsoft.tagmaster.DetailPairLayout android:id="@+id/tagIdRow" android:layout_width="match_parent" android:layout_height="wrap_content">
              <TextView android:id="@+id/tagIdLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:layout_marginEnd="5dp" android:text="@string/TagId" android:textAppearance="?attr/textAppearanceLabelLarge">
                </TextView>
              <TextView android:id="@+id/tagIdTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="?attr/textAppearanceBodyMedium">
                </TextView>
            </depollsoft.tagmaster.DetailPairLayout>
            <depollsoft.tagmaster.DetailPairLayout android:id="@+id/ratingRow" android:layout_width="match_parent" android:layout_height="wrap_content">
              <TextView android:id="@+id/textView2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:layout_marginEnd="5dp" android:clickable="false" android:longClickable="false" android:text="@string/Rating" android:textAppearance="?attr/textAppearanceLabelLarge">
                </TextView>
              <depollsoft.tagmaster.DetailRatingLayout android:id="@+id/linearLayout2" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
                <LinearLayout android:id="@+id/linearLayout4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:baselineAligned="false" android:gravity="center_vertical" android:orientation="horizontal">
                  <RatingBar android:id="@+id/ratingProgressBar" style="?android:attr/ratingBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" android:progressTint="?attr/colorPrimary" android:isIndicator="true" android:numStars="5" android:stepSize="0.1"/>
                  <TextView android:id="@+id/ratingTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textAppearance="?attr/textAppearanceBodyMedium"/>
                </LinearLayout>
                <depollsoft.tagmaster.BarberPoleLoadingView android:id="@+id/ratingSubmitProgress" style="@style/Widget.TagMaster.CompactLoader" android:layout_gravity="center_vertical" android:contentDescription="@string/detail_submitting_rating"/>
                <ImageButton android:id="@+id/rateButton" style="@style/Base.Widget.AppCompat.Button.Borderless" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:minHeight="48dp" android:layout_gravity="center_vertical" android:layout_marginStart="8dp" android:contentDescription="@string/Rate" app:tooltipText="@string/Rate" app:tint="?attr/colorPrimary" app:srcCompat="@drawable/ic_rate"/>
              </depollsoft.tagmaster.DetailRatingLayout>
            </depollsoft.tagmaster.DetailPairLayout>
            <depollsoft.tagmaster.DetailPairLayout android:id="@+id/partsRow" android:layout_width="match_parent" android:layout_height="wrap_content">
              <TextView android:id="@+id/textView3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:layout_marginEnd="5dp" android:clickable="false" android:longClickable="false" android:text="@string/Parts" android:textAppearance="?attr/textAppearanceLabelLarge">
                </TextView>
              <TextView android:id="@+id/partsTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="false" android:longClickable="false" android:textAppearance="?attr/textAppearanceBodyMedium">
                </TextView>
            </depollsoft.tagmaster.DetailPairLayout>
            <depollsoft.tagmaster.DetailPairLayout android:id="@+id/tagTypeRow" android:layout_width="match_parent" android:layout_height="wrap_content">
              <TextView android:id="@+id/textView1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:layout_marginEnd="5dp" android:clickable="false" android:longClickable="false" android:text="@string/Type" android:textAppearance="?attr/textAppearanceLabelLarge">
                </TextView>
              <TextView android:id="@+id/tagTypeTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="false" android:longClickable="false" android:textAppearance="?attr/textAppearanceBodyMedium">
                </TextView>
            </depollsoft.tagmaster.DetailPairLayout>
            <depollsoft.tagmaster.DetailPairLayout android:id="@+id/classicTagRow" android:layout_width="match_parent" android:layout_height="wrap_content">
              <TextView android:id="@+id/textView5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start|center_vertical" android:layout_marginEnd="5dp" android:clickable="false" android:longClickable="false" android:text="@string/ClassicTag" android:textAppearance="?attr/textAppearanceLabelLarge">
                </TextView>
              <TextView android:id="@+id/classicTagTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:longClickable="false" android:textAppearance="?attr/textAppearanceBodyMedium">
                </TextView>
            </depollsoft.tagmaster.DetailPairLayout>
          </depollsoft.tagmaster.DetailMetadataLayout>
          <LinearLayout android:id="@+id/keyRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/textView4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/Key" android:textAppearance="?attr/textAppearanceLabelLarge"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
              <depollsoft.tagmaster.CenteredPitchPipeButton android:id="@+id/playKeyNoteButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:minWidth="64dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="24dp" android:background="@drawable/key_button_background" android:backgroundTint="@null" android:drawableStart="@drawable/ic_key" android:drawablePadding="8dp" android:drawableTint="@color/key_button_foreground" android:text="@string/Play" android:textAllCaps="false" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="@color/key_button_foreground"/>
              <Space android:layout_width="@dimen/barberpole_compact_width" android:layout_height="1dp" android:layout_marginStart="8dp"/>
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:id="@+id/linearLayout3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/sheetMusicLink" style="?attr/materialButtonStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:minHeight="48dp" android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/SheetMusic" app:icon="@drawable/ic_sheet_music" app:iconGravity="textStart"/>
            <depollsoft.tagmaster.BarberPoleLoadingView android:id="@+id/sheetMusicProgress" style="@style/Widget.TagMaster.CompactLoader" android:layout_marginStart="8dp" android:contentDescription="@string/detail_loading"/>
          </LinearLayout>
        </depollsoft.tagmaster.DetailSectionsLayout>
        <depollsoft.tagmaster.DetailSectionsLayout android:id="@+id/summaryProse" android:layout_width="match_parent" android:layout_height="wrap_content">
          <LinearLayout android:id="@+id/lyricsRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/lyticsTitleTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginBottom="4dp" android:clickable="false" android:longClickable="false" android:text="@string/Lyrics" android:textAppearance="?attr/textAppearanceLabelLarge">
                </TextView>
            <TextView android:id="@+id/lyricsTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="fill" android:clickable="false" android:longClickable="false" android:textAppearance="?attr/textAppearanceBodyLarge">
                </TextView>
          </LinearLayout>
          <LinearLayout android:id="@+id/notesRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/textView6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginBottom="4dp" android:clickable="false" android:longClickable="false" android:text="@string/Notes" android:textAppearance="?attr/textAppearanceLabelLarge">
                </TextView>
            <TextView android:id="@+id/notesTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="fill" android:clickable="false" android:longClickable="false" android:textAppearance="?attr/textAppearanceBodyLarge">
                </TextView>
          </LinearLayout>
        </depollsoft.tagmaster.DetailSectionsLayout>
      </depollsoft.tagmaster.SummaryColumnsLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
