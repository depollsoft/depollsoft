<?xml version="1.0" encoding="utf-8"?>
<!--
  Summary: the title, the facts a singer checks before starting a tag, the key
  they can sound, and the sheet music. Rows are label-over-value stacks rather
  than a fixed table, so a large system font wraps instead of clipping.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/tm_space_xl"
    android:paddingTop="@dimen/tm_space_l">

    <depollsoft.tagmaster.ReadableWidthLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/tableLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/tm_gutter"
            android:paddingEnd="@dimen/tm_gutter">

            <LinearLayout
                android:id="@+id/markerRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/favoriteMarkerTextView"
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/tm_space_m"
                    android:drawablePadding="@dimen/tm_space_xs"
                    android:gravity="center_vertical"
                    android:text="@string/FavoriteIndicator"
                    android:textColor="?attr/colorPrimary"
                    app:drawableStartCompat="@drawable/ic_favorite"
                    app:drawableTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/teachableMarkerTextView"
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/tm_space_xs"
                    android:gravity="center_vertical"
                    android:text="@string/TeachableIndicator"
                    android:textColor="?attr/colorPrimary"
                    app:drawableStartCompat="@drawable/ic_people"
                    app:drawableTint="?attr/colorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/titleTextView"
                style="@style/TextAppearance.Material3.HeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_xs"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/akaLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_xs">

                <TextView
                    android:id="@+id/textView7"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aka"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/akaTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/versionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textView8"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Version"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/versionTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- The one action on this page that leaves it. -->
            <depollsoft.lib.ui.Hyperlink
                android:id="@+id/sheetMusicLink"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_l"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="@dimen/tm_space_s"
                android:gravity="center_vertical"
                android:minHeight="@dimen/tm_touch_target"
                android:text="@string/SheetMusic"
                android:textColor="?attr/colorPrimary"
                app:drawableStartCompat="@drawable/ic_details"
                app:drawableTint="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/keyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_l"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="@dimen/tm_touch_target">

                <TextView
                    android:id="@+id/textView4"
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Key" />

                <depollsoft.pitchperfect.lib.ui.PitchPipeButton
                    android:id="@+id/playKeyNoteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/tm_touch_target"
                    android:minWidth="@dimen/tm_touch_target"
                    android:text="@string/Play"
                    android:textAllCaps="false" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openTracksButton" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="start|center_vertical" android:text="@string/LearningTracks" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openDetailsButton" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="start|center_vertical" android:text="@string/Details" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openVideosButton" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="start|center_vertical" android:text="@string/videos" />

            <LinearLayout
                android:id="@+id/ratingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_m"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="@dimen/tm_touch_target">

                <TextView
                    android:id="@+id/textView2"
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/tm_space_m"
                    android:text="@string/Rating" />

                <LinearLayout
                    android:id="@+id/linearLayout4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ratingTextView"
                        style="@style/TextAppearance.TagMaster.FieldValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/ratingProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tm_space_xs"
                        android:indeterminate="false"
                        android:max="5000"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="6dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rateButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="@dimen/tm_touch_target"
                    android:layout_height="@dimen/tm_touch_target"
                    android:contentDescription="@string/RateThisTag"
                    app:icon="@drawable/ic_rate" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tagIdRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_m">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/TagId" />

                <TextView
                    android:id="@+id/tagIdTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/partsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s">

                <TextView
                    android:id="@+id/textView3"
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Parts" />

                <TextView
                    android:id="@+id/partsTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tagTypeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s">

                <TextView
                    android:id="@+id/textView1"
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Type" />

                <TextView
                    android:id="@+id/tagTypeTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/classicTagRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s">

                <TextView
                    android:id="@+id/textView5"
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ClassicTag" />

                <TextView
                    android:id="@+id/classicTagTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyricsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_xl"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lyticsTitleTextView"
                    style="@style/TextAppearance.TagMaster.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Lyrics" />

                <TextView
                    android:id="@+id/lyricsTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_s"
                    android:lineSpacingMultiplier="1.2"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_xl"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView6"
                    style="@style/TextAppearance.TagMaster.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Notes" />

                <TextView
                    android:id="@+id/notesTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tm_space_s"
                    android:lineSpacingMultiplier="1.2" />
            </LinearLayout>
        </LinearLayout>
    </depollsoft.tagmaster.ReadableWidthLayout>

</androidx.core.widget.NestedScrollView>
