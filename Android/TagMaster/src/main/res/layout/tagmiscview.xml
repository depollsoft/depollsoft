<?xml version="1.0" encoding="utf-8"?>
<!--
  Details: where this tag came from and who made it. Attribution to
  BarbershopTags.com and to the arranger, poster and quartet stays first-class.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/miscScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/tm_space_xl"
    android:paddingTop="@dimen/tm_space_l">

    <depollsoft.tagmaster.ReadableWidthLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/tm_gutter"
            android:paddingEnd="@dimen/tm_gutter">

            <TextView
                android:id="@+id/titleTextView"
                style="@style/TextAppearance.Material3.HeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/postedByRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_l"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/PostedBy" />

                <depollsoft.lib.ui.Hyperlink
                    android:id="@+id/postedByTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/tm_touch_target"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/postedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_m"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Posted" />

                <TextView
                    android:id="@+id/postedTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/arrangedByRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_m"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ArrangedBy" />

                <depollsoft.lib.ui.Hyperlink
                    android:id="@+id/arrangedByTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/tm_touch_target"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/yearArrangedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/YearArranged" />

                <TextView
                    android:id="@+id/yearArrangedTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sungByRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_m"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/SungBy" />

                <depollsoft.lib.ui.Hyperlink
                    android:id="@+id/sungByTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/tm_touch_target"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/yearSungRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/YearSung" />

                <TextView
                    android:id="@+id/yearSungTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/downloadsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_l">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Downloads" />

                <TextView
                    android:id="@+id/downloadsTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lastRefreshedRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_s">

                <TextView
                    style="@style/TextAppearance.TagMaster.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/LastRefreshed" />

                <TextView
                    android:id="@+id/lastRefreshedTextView"
                    style="@style/TextAppearance.TagMaster.FieldValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- The catalogue entry this screen is built from. -->
            <depollsoft.lib.ui.Hyperlink
                android:id="@+id/linkHyperlink"
                style="@style/TextAppearance.TagMaster.FieldValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tm_space_l"
                android:gravity="center_vertical"
                android:minHeight="@dimen/tm_touch_target"
                android:text="@string/BarbershopTagsCom"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </depollsoft.tagmaster.ReadableWidthLayout>

</androidx.core.widget.NestedScrollView>
