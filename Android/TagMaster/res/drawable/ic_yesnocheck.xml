<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="24dp" android:height="24dp" android:right="4dp">
        <selector>
            <item android:drawable="@drawable/ic_check" android:state_checked="true"/>
            <!--pressed-->
            <item android:drawable="@drawable/ic_clear" android:state_checked="false"/>
            <!--focused-->
            <item android:drawable="@drawable/ic_clear"/>
            <!--default-->
        </selector>
    </item>
</layer-list>

