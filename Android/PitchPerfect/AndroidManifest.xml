<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="depollsoft.pitchperfect"
    android:versionCode="15"
    android:versionName="@string/app_version" >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-sdk android:minSdkVersion="4" android:targetSdkVersion="13">
    </uses-sdk>

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:name="depollsoft.pitchperfect.PitchPerfectApplication" >
        <activity
            android:configChanges="keyboardHidden|orientation"
            android:label="@string/app_name"
            android:name=".PitchPerfectActivity" >
            <intent-filter >
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:name="com.google.ads.AdActivity" />
        <activity
            android:configChanges="keyboardHidden|orientation"
            android:name=".KeySignatureActivity" >
        </activity>
        <activity
            android:configChanges="keyboardHidden|orientation"
            android:name=".NoteListActivity" >
        </activity>
        <activity
            android:configChanges="keyboardHidden|orientation"
            android:name=".PitchPipeActivity" >
        </activity>
        <activity
            android:configChanges="keyboardHidden|orientation"
            android:name=".SongListActivity" >
        </activity>
        <activity android:name=".AddSongActivity" >
        </activity>
        <activity
            android:label="@string/app_name"
            android:name=".SettingsActivity" >
        </activity>

        <!-- Used for install referrer tracking -->
        <receiver
            android:exported="true"
            android:name="com.google.android.apps.analytics.AnalyticsReceiver" >
            <intent-filter >
                <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>