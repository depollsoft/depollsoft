                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:textSize="18dp" >
            </Button>

            <Button
                android:id="@+id/pitchButton1"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:textSize="18dp" >
            </Button>

            <Button
                android:id="@+id/pitchButton2"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:textSize="18dp" >
