<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent" android:layout_height="fill_parent">
	<LinearLayout android:id="@+id/linearLayout1"
		android:layout_height="fill_parent" android:layout_width="fill_parent"
		android:orientation="vertical">
		<TableLayout android:layout_width="fill_parent"
			android:id="@+id/tableLayout1" android:layout_height="fill_parent"
			android:stretchColumns="*">
			<TableRow android:id="@+id/tableRow1" android:layout_width="fill_parent"
				android:layout_height="wrap_content" android:layout_weight="1">
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content"
					android:id="@+id/pitchButton0" android:textSize="18dp"></depollsoft.pitchperfect.lib.ui.PitchPipeButton>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:id="@+id/pitchButton1" android:layout_height="fill_parent"
					android:layout_width="wrap_content" android:textSize="18dp"></depollsoft.pitchperfect.lib.ui.PitchPipeButton>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:id="@+id/pitchButton2" android:layout_height="fill_parent"
					android:layout_width="wrap_content" android:textSize="18dp"></depollsoft.pitchperfect.lib.ui.PitchPipeButton>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content"
					android:id="@+id/pitchButton3" android:textSize="18dp"></depollsoft.pitchperfect.lib.ui.PitchPipeButton>
			</TableRow>
			<TableRow android:id="@+id/tableRow2" android:layout_width="fill_parent"
				android:layout_height="wrap_content" android:layout_weight="1">
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton11" android:textSize="18dp"/>
				<RadioButton android:layout_width="fill_parent" android:layout_span="2"
					android:layout_height="wrap_content" android:text="@string/CtoC" android:id="@+id/cToCButton"/>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton4" android:textSize="18dp"/>
			</TableRow>
			<TableRow android:id="@+id/tableRow3" android:layout_width="fill_parent"
				android:layout_height="wrap_content" android:layout_weight="1">
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton10" android:textSize="18dp"/>
				<RadioButton android:layout_width="fill_parent" android:layout_span="2"
					android:layout_height="wrap_content" android:text="@string/FtoF" android:id="@+id/fToFButton"/>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton5" android:textSize="18dp"/>
			</TableRow>
			<TableRow android:id="@+id/tableRow4" android:layout_width="fill_parent"
				android:layout_weight="1" android:layout_height="wrap_content">
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton9" android:textSize="18dp"/>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton8" android:textSize="18dp"/>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton7" android:textSize="18dp"/>
				<depollsoft.pitchperfect.lib.ui.PitchPipeButton
					android:layout_height="fill_parent" android:layout_width="wrap_content" android:id="@+id/pitchButton6" android:textSize="18dp"/>
			</TableRow>
		</TableLayout>
	</LinearLayout>
</FrameLayout>
