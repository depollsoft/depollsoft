<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@drawable/row_lit"
              android:gravity="center_vertical"
              android:orientation="horizontal">

    <View
        android:id="@+id/setListRowCurrentDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/plate_lit_dot"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/setListRowName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-condensed"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:textColor="@color/pitch_button_text"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/setListRowCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:textColor="@color/pitch_row_secondary"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/setListRowOverflow"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:contentDescription="@string/SetListRowActions"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_more_vert"
        app:tint="@color/plate_ink_secondary" />

    <ImageView
        android:id="@+id/setListRowDragHandle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/SetListReorder"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/ic_drag_handle"
        app:tint="@color/plate_ink_secondary" />
</LinearLayout>
