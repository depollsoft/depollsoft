<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
             android:layout_width="fill_parent"
             android:layout_height="fill_parent">

    <ListView
        android:id="@+id/majorKeySignatureListView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@android:color/transparent"
        android:cacheColorHint="#00000000"
        android:divider="@color/plate_hairline"
        android:dividerHeight="1px"
        android:paddingBottom="90dp"
        android:clipToPadding="false"
        android:visibility="invisible">
    </ListView>

    <ListView
        android:id="@+id/minorKeySignatureListView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@android:color/transparent"
        android:cacheColorHint="#00000000"
        android:divider="@color/plate_hairline"
        android:dividerHeight="1px"
        android:paddingBottom="90dp"
        android:clipToPadding="false"
        android:visibility="invisible">
    </ListView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/majorMinorFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:textColor="@color/plate_ink"
        app:backgroundTint="@color/plate_surface"
        app:iconTint="@color/plate_ink"
        app:strokeColor="@color/plate_hairline"
        app:strokeWidth="1dp"/>
</FrameLayout>