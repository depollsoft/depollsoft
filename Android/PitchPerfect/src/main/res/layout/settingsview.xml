<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <depollsoft.pitchperfect.CropFillImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:srcCompat="@color/plate_ground" />

    <depollsoft.pitchperfect.HeritageScoreView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/SectionPitchPipe"
                android:textAppearance="@style/TextAppearance.Plate.SectionHeader" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/toggleNoteCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/NotesToggle"
                android:textColor="@color/plate_ink"
                android:textSize="16sp"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/wakeLockCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/WakeLock"
                android:textColor="@color/plate_ink"
                android:textSize="16sp"
                app:useMaterialThemeColors="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearSongListButton"
                style="@style/Widget.Plate.SettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ClearSongList" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/SectionAccount"
                android:textAppearance="@style/TextAppearance.Plate.SectionHeader" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/LogInInfo"
                android:textColor="@color/plate_ink_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/loginButtonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    style="@style/Widget.Plate.SettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/LogIn" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    style="@style/Widget.Plate.SettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/LogOut" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteAccountButton"
                    style="@style/Widget.Plate.SettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/DeleteAccount" />
            </LinearLayout>

            <TextView
                android:id="@+id/themeTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/SectionAppearance"
                android:textAppearance="@style/TextAppearance.Plate.SectionHeader" />

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_system"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/theme_system"
                    android:textColor="@color/plate_ink"
                    android:textSize="16sp"
                    app:useMaterialThemeColors="true" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_light"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/theme_light"
                    android:textColor="@color/plate_ink"
                    android:textSize="16sp"
                    app:useMaterialThemeColors="true" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/theme_dark"
                    android:textColor="@color/plate_ink"
                    android:textSize="16sp"
                    app:useMaterialThemeColors="true" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageSubscriptionButton"
                style="@style/Widget.Plate.SettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/manage_subscription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/SectionAbout"
                android:textAppearance="@style/TextAppearance.Plate.SectionHeader" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changelogButton"
                style="@style/Widget.Plate.SettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ViewChangelog" />

            <include layout="@layout/aboutfooter" />

            <LinearLayout
                android:id="@+id/privateBuildDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Private Build"
                    android:textAppearance="@style/TextAppearance.Plate.SectionHeader" />

                <TextView
                    android:id="@+id/privateBuildMetadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/plate_ink_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyLogsButton"
                    style="@style/Widget.Plate.SettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Copy Logs" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
