<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:paddingStart="24dp"
             android:paddingEnd="24dp"
             android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/setListNameLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/SetListNameLabel"
        app:boxStrokeColor="@color/plate_hairline"
        app:boxStrokeErrorColor="@color/plate_ink"
        app:errorIconDrawable="@null"
        app:errorTextColor="@color/plate_ink"
        app:helperTextTextColor="@color/plate_ink_secondary"
        app:errorTextAppearance="@style/TextAppearance.Plate.FieldError"
        app:helperTextTextAppearance="@style/TextAppearance.Plate.FieldError"
        app:hintTextColor="@color/plate_ink_secondary"
        app:shapeAppearance="@style/ShapeAppearance.Plate">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/setListNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/plate_ink"
            android:textSize="20sp" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
