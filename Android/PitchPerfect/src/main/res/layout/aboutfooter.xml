<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/plate_ink_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="@color/plate_ink_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/VersionString"
            android:textColor="@color/plate_ink_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutPurchased"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/Purchased"
            android:textColor="@color/plate_ink_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <depollsoft.lib.ui.Hyperlink
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="http://apps.depoll.com"
            android:text="@string/DepollSoft"
            android:textColor="@color/plate_ink_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/copyrightTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/Copyright"
            android:textColor="@color/plate_ink_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <depollsoft.lib.ui.Hyperlink
        android:id="@+id/homepageHyperlink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="http://apps.depoll.com"
        android:text="@string/HomePage"
        android:textColor="@color/plate_ink_secondary"
        android:textSize="14sp" />

    <depollsoft.lib.ui.Hyperlink
        android:id="@+id/rateReviewHyperlink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="https://play.google.com/store/apps/details?id=depollsoft.pitchperfect"
        android:text="@string/RateReview"
        android:textColor="@color/plate_ink_secondary"
        android:textSize="14sp" />

    <depollsoft.lib.ui.Hyperlink
        android:id="@+id/Hyperlink01"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="http://apps.depoll.com/terms-of-use"
        android:text="@string/TermsOfUse"
        android:textColor="@color/plate_ink_secondary"
        android:textSize="14sp" />
</LinearLayout>
