<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.Light">
        <!-- Bars are part of the plate: surface tone, hairline edge, ink type. -->
        <item name="colorPrimary">@color/plate_surface</item>
        <item name="colorPrimaryVariant">@color/plate_surface</item>
        <item name="colorPrimaryDark">@color/plate_surface</item>
        <item name="colorOnPrimary">@color/plate_ink</item>
        <item name="colorSecondary">@color/plate_accent</item>
        <item name="colorOnSecondary">@color/plate_on_accent</item>
        <item name="colorAccent">@color/plate_accent</item>
        <item name="colorSurface">@color/plate_surface</item>
        <item name="colorOnSurface">@color/plate_ink</item>
        <item name="android:windowBackground">@color/plate_ground</item>
        <item name="android:textColorPrimary">@color/plate_ink</item>
        <item name="android:textColorSecondary">@color/plate_ink_secondary</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Plate</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Plate</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/plate_surface</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>
        <item name="bottomNavigationStyle">@style/Widget.Plate.BottomNavigation</item>
        <item name="actionBarStyle">@style/Widget.Plate.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Plate.ActionBar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
    </style>

    <style name="Widget.Plate.ActionBar" parent="Widget.MaterialComponents.ActionBar.Surface">
        <item name="android:background">@drawable/bar_surface_bottom_edge</item>
        <item name="background">@drawable/bar_surface_bottom_edge</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.Plate.ActionBarTitle</item>
    </style>

    <style name="ThemeOverlay.Plate.ActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar.Surface">
        <item name="colorControlNormal">@color/plate_ink</item>
        <item name="android:textColorPrimary">@color/plate_ink</item>
    </style>

    <style name="Widget.Plate.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bar_surface_top_edge</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
    </style>

    <style name="TextAppearance.Plate.ActionBarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/plate_ink</item>
        <item name="android:fontFamily">@font/oswald_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <style name="Widget.Plate.SettingsButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">@font/oswald_medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/plate_ink</item>
        <item name="backgroundTint">@color/plate_surface</item>
        <item name="strokeColor">@color/plate_hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">2dp</item>
    </style>

    <style name="Widget.Plate.WidgetHitRow" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.Plate.WidgetHit" parent="android:Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="ShapeAppearance.Plate" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">2dp</item>
    </style>

    <style name="TextAppearance.Plate.SectionHeader" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/plate_ink_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
