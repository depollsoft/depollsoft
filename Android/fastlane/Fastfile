default_platform(:android)

def with_retries(label, attempts: 3, delay_seconds: 30)
  attempt = 1

  begin
    yield
  rescue StandardError => error
    raise if attempt >= attempts

    UI.important("#{label} failed on attempt #{attempt}/#{attempts}: #{error.message}")
    sleep(delay_seconds * attempt)
    attempt += 1
    retry
  end
end

platform :android do
  desc "Build and upload private Android bundles to Play internal testing"
  lane :deploy_private do
    build_number = (ENV["DEPOLLSOFT_PRIVATE_BUILD_NUMBER"] || ENV["CI_BUILD_NUMBER"] || (Time.now.to_i / 10).to_s).to_s

    %w[PitchPerfect TagMaster PitchPerfectWear].each do |app|
      gradle(
        task: ":#{app}:bundlePrivate",
        project_dir: ".",
        properties: {
          "DEPOLLSOFT_PRIVATE_BUILD_NUMBER" => build_number,
          "DEPOLLSOFT_PRIVATE_PR_NUMBER" => ENV["PR_NUMBER"].to_s,
        },
      )
    end

    # The Wear bundle shares the phone's package and goes to the Wear OS
    # form-factor track of the same Play app. Its version code carries the
    # module's own suffix (build number * 10 + 1) so it never collides with
    # the phone bundle on that package.
    base_version_code = build_number.to_i * 10
    deployments = [
      {
        label: "Pitch Perfect phone",
        package_name: "depollsoft.pitchperfect.private",
        track: "internal",
        aab: "PitchPerfect/build/outputs/bundle/private/PitchPerfect-private.aab",
        version_code: base_version_code,
      },
      {
        label: "Pitch Perfect Wear",
        package_name: "depollsoft.pitchperfect.private",
        track: "wear:internal",
        aab: "PitchPerfectWear/build/outputs/bundle/private/PitchPerfectWear-private.aab",
        version_code: base_version_code + 1,
      },
      {
        label: "Tag Master",
        package_name: "depollsoft.tagmaster.private",
        track: "internal",
        aab: "TagMaster/build/outputs/bundle/private/TagMaster-private.aab",
        version_code: base_version_code + 1,
      },
    ]

    deployments.each do |deployment|
      with_retries("Upload #{deployment[:label]} to Play #{deployment[:track]}") do
        active_version_codes = google_play_track_version_codes(
          package_name: deployment[:package_name],
          track: deployment[:track],
          json_key: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON_PATH"),
        )

        if active_version_codes.map(&:to_i).include?(deployment[:version_code])
          UI.success(
            "#{deployment[:label]} version #{deployment[:version_code]} " +
              "is already active on #{deployment[:track]}",
          )
          next
        end

        upload_to_play_store(
          package_name: deployment[:package_name],
          track: deployment[:track],
          json_key: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON_PATH"),
          aab: deployment[:aab],
          skip_upload_metadata: true,
          skip_upload_images: true,
          skip_upload_screenshots: true,
          skip_upload_apk: true,
          release_status: "completed",
          changes_not_sent_for_review: true,
          rescue_changes_not_sent_for_review: true,
        )
      end
    end

    if File.file?("build/private-listing/metadata/en-US/images/icon.png")
      with_retries("Upload Pitch Perfect listing icon") do
        upload_to_play_store(
          package_name: "depollsoft.pitchperfect.private",
          json_key: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON_PATH"),
          metadata_path: "build/private-listing/metadata",
          skip_upload_apk: true,
          skip_upload_aab: true,
          skip_upload_metadata: true,
          skip_upload_changelogs: true,
          skip_upload_screenshots: true,
          skip_upload_images: false,
          changes_not_sent_for_review: true,
          rescue_changes_not_sent_for_review: true,
        )
      end
    else
      UI.important("Skipping Pitch Perfect listing icon upload: build/private-listing/metadata/en-US/images/icon.png does not exist")
    end
  end

  desc "Upload a private APK or AAB to Play Internal App Sharing"
  lane :internal_app_sharing do |options|
    package_name = options[:package_name].to_s
    supported_packages = [
      "depollsoft.pitchperfect.private",
      "depollsoft.tagmaster.private",
    ]
    unless supported_packages.include?(package_name)
      UI.user_error!(
        "Unsupported package_name '#{package_name}'. Expected one of: " +
          supported_packages.join(", "),
      )
    end

    apk_path = options[:apk_path] || options[:apk]
    aab_path = options[:aab_path] || options[:aab]
    if apk_path.to_s.empty? && aab_path.to_s.empty?
      UI.user_error!("Provide apk_path/apk or aab_path/aab")
    end

    upload_options = {
      package_name: package_name,
      json_key: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON_PATH"),
    }
    if apk_path.to_s.empty?
      upload_options[:aab] = File.expand_path(aab_path)
    else
      upload_options[:apk] = File.expand_path(apk_path)
    end

    urls = upload_to_play_store_internal_app_sharing(upload_options)
    url = Array(urls).first.to_s
    if url.empty?
      UI.user_error!("Internal App Sharing upload returned no install URL")
    end

    output_file = ENV["INTERNAL_APP_SHARING_URL_FILE"].to_s
    File.write(output_file, "#{url}\n") unless output_file.empty?
    UI.success("Internal App Sharing URL: #{url}")
  end
end

import '../../scripts/release/production.rb'
