workspace 'iOS'

platform :ios, '13.0'
use_frameworks!

project 'depolllib/depolllib.xcodeproj'
project 'pitchperfect/pitchperfectlib/pitchperfectlib.xcodeproj'

target 'tagmaster' do
    project 'tagmaster/tagmaster.xcodeproj'
    pod 'Parse'
    pod 'Bolts/Tasks', inhibit_warnings: true
    pod 'Firebase/Analytics'
    pod 'Firebase/Auth'
    pod 'Firebase/Firestore', inhibit_warnings: true
    pod 'FirebaseFirestore', inhibit_warnings: true
    pod 'Firebase/Performance'
    pod 'Firebase/Functions'
    pod 'Firebase/Crashlytics'
    pod 'FirebaseUI/Auth'
    pod 'FirebaseUI/OAuth'
    pod 'FirebaseUI/Email'
    pod 'FirebaseUI/Google'
    pod 'FirebaseUI/Facebook'
    pod 'Protobuf', inhibit_warnings: true
    pod 'SmartlookConsentSDK'
end

target 'pitchperfect' do
    project 'pitchperfect/pitchperfect.xcodeproj'
    pod 'Parse'
    pod 'Bolts/Tasks', inhibit_warnings: true
    pod 'Firebase/Analytics'
    pod 'Firebase/Auth'
    pod 'Firebase/Firestore', inhibit_warnings: true
    pod 'FirebaseFirestore', inhibit_warnings: true
    pod 'Firebase/Performance'
    pod 'Firebase/Functions'
    pod 'Firebase/Crashlytics'
    pod 'FirebaseUI/Auth'
    pod 'FirebaseUI/OAuth'
    pod 'FirebaseUI/Email'
    pod 'FirebaseUI/Google'
    pod 'FirebaseUI/Facebook'
    pod 'Google-Mobile-Ads-SDK'
    pod 'Protobuf', inhibit_warnings: true
end

post_install do |installer|
    installer.pods_project.targets.each do |target|
        target.build_configurations.each do |config|
            if Gem::Version.new('9.0') > Gem::Version.new(config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'])
                config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '9.0'
            end
        end
    end
    installer.pods_project.build_configurations.each do |config|
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
    end
end
