<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_height="wrap_content" android:layout_width="wrap_content">
	<depollsoft.lib.ui.LoadingImageView
		android:id="@+id/videoPreview" android:layout_marginBottom="4dp"
		android:layout_marginTop="4dp" android:layout_weight="0" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:layout_gravity="center_vertical" android:layout_width="80dp" android:layout_height="60dp"/>
	<TableLayout android:id="@+id/tableLayout1" android:layout_height="wrap_content" android:layout_width="fill_parent" android:layout_weight="1" android:shrinkColumns="1" android:stretchColumns="1" android:layout_gravity="center_vertical|fill_horizontal">
		<TableRow android:id="@+id/tableRow1" android:layout_width="wrap_content"
			android:layout_height="wrap_content">
			<TextView android:layout_marginRight="5dip" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/textView1" android:text="@string/Teacher" android:clickable="false" android:longClickable="false" android:linksClickable="false" android:textSize="12dp"></TextView>
			<TextView android:text="TextView" android:layout_height="wrap_content" android:inputType="textMultiLine" android:layout_width="fill_parent" android:id="@+id/teacherTextView" android:clickable="false" android:longClickable="false" android:linksClickable="false" android:textSize="12dp"></TextView>
		</TableRow>
	</TableLayout>
</LinearLayout>
